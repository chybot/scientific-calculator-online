---
interface HreflangEntry { lang: string; url: string; }

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  jsonLd?: object | object[];
  /** Page language for <html lang> and og:locale */
  lang?: string;
  /** Hreflang alternates (omit if page is en-only) */
  alternates?: HreflangEntry[];
}

const {
  title,
  description,
  ogImage = '/og.png',
  canonicalURL,
  jsonLd,
  lang = 'en',
  alternates,
} = Astro.props;

// Derive language switcher links from alternates (so pages declare once)
type LangCode = 'en' | 'fr' | 'es';
const switcherLinks: Partial<Record<LangCode, string>> = {};
if (alternates) {
  for (const a of alternates) {
    if (a.lang === 'en' || a.lang === 'fr' || a.lang === 'es') {
      // Strip absolute origin so the dropdown navigates within same site
      switcherLinks[a.lang] = a.url.replace(/^https?:\/\/[^/]+/, '') || '/';
    }
  }
}
const switcherLang = (lang === 'fr' || lang === 'es') ? lang : 'en';

// UI chrome translations (header nav + footer) keyed by page lang
const uiStrings: Record<LangCode, {
  calculators: string;
  allCalculators: string;
  about: string;
  siteTagline: string;
  resources: string;
  privacy: string;
  terms: string;
  contact: string;
  disclaimer: string;
  rights: string;
}> = {
  en: {
    calculators: 'Calculators',
    allCalculators: 'All Calculators',
    about: 'About',
    siteTagline: 'Free online scientific calculator for students. Natural math display, fractions, statistics, and table mode. Designed for coursework compatibility.',
    resources: 'Resources',
    privacy: 'Privacy Policy',
    terms: 'Terms of Use',
    contact: 'Contact',
    disclaimer: 'This is an independently developed simulator — not made by, endorsed by, or affiliated with Texas Instruments Inc. TI-30XS MultiView, TI-30X IIS, TI-30XA, TI-84, TI-85, TI-Nspire, EOS, and MathPrint are trademarks of Texas Instruments Incorporated, used here for identification only (nominative fair use).',
    rights: 'All rights reserved.',
  },
  fr: {
    calculators: 'Calculatrices',
    allCalculators: 'Toutes les calculatrices',
    about: 'À propos',
    siteTagline: 'Calculatrice scientifique en ligne gratuite pour étudiants. Affichage mathématique naturel, fractions, statistiques et mode tableau.',
    resources: 'Ressources',
    privacy: 'Politique de confidentialité',
    terms: "Conditions d'utilisation",
    contact: 'Contact',
    disclaimer: "Ceci est un simulateur développé indépendamment — non créé par, non approuvé par ni affilié à Texas Instruments Inc. TI-30XS MultiView, TI-30X IIS, TI-30XA, TI-84, TI-85, TI-Nspire, EOS et MathPrint sont des marques de Texas Instruments Incorporated, utilisées ici uniquement à des fins d'identification (usage référentiel).",
    rights: 'Tous droits réservés.',
  },
  es: {
    calculators: 'Calculadoras',
    allCalculators: 'Todas las calculadoras',
    about: 'Acerca de',
    siteTagline: 'Calculadora científica en línea gratuita para estudiantes. Pantalla matemática natural, fracciones, estadísticas y modo tabla.',
    resources: 'Recursos',
    privacy: 'Política de privacidad',
    terms: 'Términos de uso',
    contact: 'Contacto',
    disclaimer: 'Este es un simulador desarrollado de forma independiente — no creado por, ni avalado por, ni afiliado a Texas Instruments Inc. TI-30XS MultiView, TI-30X IIS, TI-30XA, TI-84, TI-85, TI-Nspire, EOS y MathPrint son marcas de Texas Instruments Incorporated, usadas aquí solo con fines de identificación (uso referencial).',
    rights: 'Todos los derechos reservados.',
  },
};
const t = uiStrings[switcherLang];

// Calculator nav items; model pages with a localized version link to it
const localizedPages: Partial<Record<LangCode, Record<string, string>>> = {
  fr: {
    '/': '/fr/ti-30xs/',
    '/ti-85/': '/fr/ti-85/',
    '/ti-84/': '/fr/ti-84/',
    '/ti-nspire/': '/fr/ti-nspire/',
    '/ti-30xa/': '/fr/ti-30xa/',
    '/ti-30xiis/': '/fr/ti-30xiis/',
  },
  es: {
    '/': '/es/ti-30xs/',
    '/ti-85/': '/es/ti-85/',
    '/ti-84/': '/es/ti-84/',
    '/ti-nspire/': '/es/ti-nspire/',
    '/ti-30xa/': '/es/ti-30xa/',
    '/ti-30xiis/': '/es/ti-30xiis/',
  },
};
const localize = (href: string) => localizedPages[switcherLang]?.[href] ?? href;
const calcLinks = [
  { href: '/', label: 'TI-30XS MultiView' },
  { href: '/ti-85/', label: 'TI-85' },
  { href: '/ti-84/', label: 'TI-84 Plus' },
  { href: '/ti-nspire/', label: 'TI-Nspire CX' },
  { href: '/ti-30xa/', label: 'TI-30XA' },
  { href: '/ti-30xiis/', label: 'TI-30X IIS' },
].map((l) => ({ ...l, href: localize(l.href) }));

const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://scientificcalc.org';
const canonical = canonicalURL ?? Astro.url.href;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`;

import '../styles/global.css';
import Analytics from '../components/analytics/Analytics.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Scientific Calculator Online',
  url: siteURL,
  description: 'Free online scientific calculator for students. Natural math display, fractions, statistics, and table mode.',
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [websiteJsonLd, ...jsonLd] : [websiteJsonLd, jsonLd]
  : [websiteJsonLd];
---

<!doctype html>
<html lang={lang} class="bg-bg text-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates && alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.url} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.lang === 'en')?.url ?? canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Scientific Calculator Online" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- JSON-LD -->
    {allJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Analytics (GA4 + Cloudflare + custom events) -->
    <Analytics />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1a2e" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SciCalc" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-border bg-bg-card/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 flex items-center justify-between min-h-[56px]">
        <a href="/" class="text-lg font-bold text-text hover:text-primary transition-colors min-h-[44px] flex items-center">
          ⌘ SciCalc Online
        </a>
        <div class="flex items-center gap-1 text-sm text-text-muted">
          <div class="relative group">
            <button class="min-h-[44px] px-2 hover:text-text transition-colors flex items-center gap-1" aria-haspopup="true">
              {t.calculators} <span class="text-[10px]" aria-hidden="true">▾</span>
            </button>
            <div role="menu" class="absolute right-0 top-full mt-1 bg-bg-card border border-border rounded-lg shadow-xl py-1 min-w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all z-50">
              {calcLinks.map((l) => (
                <a href={l.href} role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">{l.label}</a>
              ))}
              <div class="border-t border-border my-1" role="separator"></div>
              <a href="/calculators/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors text-text-muted text-xs">{t.allCalculators}</a>
            </div>
          </div>
          <a href="/about/" class="min-h-[44px] px-2 hover:text-text transition-colors flex items-center">{t.about}</a>
          <LanguageSwitcher current={switcherLang} links={switcherLinks} />
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-bg-card/50 mt-auto">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-text-muted">
          <div>
            <h3 class="font-semibold text-text mb-2">Scientific Calculator Online</h3>
            <p>{t.siteTagline}</p>
          </div>
          <div>
            <h3 class="font-semibold text-text mb-2">{t.calculators}</h3>
            <ul class="space-y-1">
              {calcLinks.map((l) => (
                <li><a href={l.href} class="hover:text-text transition-colors">{l.label}</a></li>
              ))}
              <li><a href="/calculators/" class="hover:text-text transition-colors">{t.allCalculators}</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-text mb-2">{t.resources}</h3>
            <ul class="space-y-1">
              <li><a href="/about/" class="hover:text-text transition-colors">{t.about}</a></li>
              <li><a href="/privacy/" class="hover:text-text transition-colors">{t.privacy}</a></li>
              <li><a href="/terms/" class="hover:text-text transition-colors">{t.terms}</a></li>
              <li><a href="/contact/" class="hover:text-text transition-colors">{t.contact}</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-4 border-t border-border text-xs text-text-muted text-center">
          <p>{t.disclaimer}</p>
          <p class="mt-1">&copy; {new Date().getFullYear()} Scientific Calculator Online. {t.rights}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
