---
interface HreflangEntry { lang: string; url: string; }

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  jsonLd?: object | object[];
  /** Page language for <html lang> and og:locale */
  lang?: string;
  /** Hreflang alternates (omit if page is en-only) */
  alternates?: HreflangEntry[];
}

const {
  title,
  description,
  ogImage = '/og.png',
  canonicalURL,
  jsonLd,
  lang = 'en',
  alternates,
} = Astro.props;

// Derive language switcher links from alternates (so pages declare once)
type LangCode = 'en' | 'fr' | 'es';
const switcherLinks: Partial<Record<LangCode, string>> = {};
if (alternates) {
  for (const a of alternates) {
    if (a.lang === 'en' || a.lang === 'fr' || a.lang === 'es') {
      // Strip absolute origin so the dropdown navigates within same site
      switcherLinks[a.lang] = a.url.replace(/^https?:\/\/[^/]+/, '') || '/';
    }
  }
}
const switcherLang = (lang === 'fr' || lang === 'es') ? lang : 'en';

const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://scientificcalc.org';
const canonical = canonicalURL ?? Astro.url.href;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`;

import '../styles/global.css';
import Analytics from '../components/analytics/Analytics.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Scientific Calculator Online',
  url: siteURL,
  description: 'Free online scientific calculator for students. Natural math display, fractions, statistics, and table mode.',
};

const allJsonLd = jsonLd
  ? Array.isArray(jsonLd) ? [websiteJsonLd, ...jsonLd] : [websiteJsonLd, jsonLd]
  : [websiteJsonLd];
---

<!doctype html>
<html lang={lang} class="bg-bg text-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates && alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.url} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.lang === 'en')?.url ?? canonical} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Scientific Calculator Online" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- JSON-LD -->
    {allJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Analytics (GA4 + Cloudflare + custom events) -->
    <Analytics />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1a2e" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SciCalc" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-border bg-bg-card/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 flex items-center justify-between min-h-[56px]">
        <a href="/" class="text-lg font-bold text-text hover:text-primary transition-colors min-h-[44px] flex items-center">
          ⌘ SciCalc Online
        </a>
        <div class="flex items-center gap-1 text-sm text-text-muted">
          <div class="relative group">
            <button class="min-h-[44px] px-2 hover:text-text transition-colors flex items-center gap-1" aria-haspopup="true">
              Calculators <span class="text-[10px]" aria-hidden="true">▾</span>
            </button>
            <div role="menu" class="absolute right-0 top-full mt-1 bg-bg-card border border-border rounded-lg shadow-xl py-1 min-w-52 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all z-50">
              <a href="/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-30XS MultiView</a>
              <a href="/ti-85/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-85</a>
              <a href="/ti-84/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-84 Plus</a>
              <a href="/ti-nspire/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-Nspire CX</a>
              <a href="/ti-30xa/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-30XA</a>
              <a href="/ti-30xiis/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors">TI-30X IIS</a>
              <div class="border-t border-border my-1" role="separator"></div>
              <a href="/calculators/" role="menuitem" class="flex items-center px-4 min-h-[44px] hover:bg-bg transition-colors text-text-muted text-xs">All Calculators</a>
            </div>
          </div>
          <a href="/about/" class="min-h-[44px] px-2 hover:text-text transition-colors flex items-center">About</a>
          <LanguageSwitcher current={switcherLang} links={switcherLinks} />
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-bg-card/50 mt-auto">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-text-muted">
          <div>
            <h3 class="font-semibold text-text mb-2">Scientific Calculator Online</h3>
            <p>Free online scientific calculator for students. Natural math display, fractions, statistics, and table mode. Designed for coursework compatibility.</p>
          </div>
          <div>
            <h3 class="font-semibold text-text mb-2">Calculators</h3>
            <ul class="space-y-1">
              <li><a href="/" class="hover:text-text transition-colors">TI-30XS MultiView</a></li>
              <li><a href="/ti-85/" class="hover:text-text transition-colors">TI-85</a></li>
              <li><a href="/ti-84/" class="hover:text-text transition-colors">TI-84 Plus</a></li>
              <li><a href="/ti-nspire/" class="hover:text-text transition-colors">TI-Nspire CX</a></li>
              <li><a href="/ti-30xa/" class="hover:text-text transition-colors">TI-30XA</a></li>
              <li><a href="/ti-30xiis/" class="hover:text-text transition-colors">TI-30X IIS</a></li>
              <li><a href="/calculators/" class="hover:text-text transition-colors">All Calculators</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-text mb-2">Resources</h3>
            <ul class="space-y-1">
              <li><a href="/about/" class="hover:text-text transition-colors">About</a></li>
              <li><a href="/privacy/" class="hover:text-text transition-colors">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-text transition-colors">Terms of Use</a></li>
              <li><a href="/contact/" class="hover:text-text transition-colors">Contact</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 pt-4 border-t border-border text-xs text-text-muted text-center">
          <p>This is an independently developed simulator, not made by or affiliated with Texas Instruments Inc. TI-30XS MultiView, TI-85, TI-84, and MathPrint are trademarks of Texas Instruments Incorporated.</p>
          <p class="mt-1">&copy; {new Date().getFullYear()} Scientific Calculator Online. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
