---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/calculator/Calculator';
import { ti85 } from '../calculators/ti-85';

const title = 'TI-85 Calculator Online Free — Scientific & Graphing Simulator (No Download)';
const description = 'Free TI-85 calculator online with scientific functions, trigonometry, logarithms & statistics. Browser-based simulator — works on desktop & mobile, no install, no download.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — TI-85 Calculator Simulator',
    description: 'Free online TI-85 calculator simulator with advanced scientific functions, complex numbers, and equation solving.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/ti-85/',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Advanced scientific calculator functions',
      'Trigonometric functions with DEG/RAD/GRAD modes',
      'Logarithmic and exponential functions',
      'Absolute value and advanced math',
      'Statistics: 1-variable and 2-variable analysis',
      'Table mode for function evaluation',
      'Memory storage (7 variables)',
      'Scientific notation',
      'Combinatorics (nPr, nCr)',
      'Works on mobile and desktop browsers',
      'Keyboard shortcuts support',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculators', item: 'https://scientificcalc.org/calculators/' },
      { '@type': 'ListItem', position: 3, name: 'TI-85 Calculator', item: 'https://scientificcalc.org/ti-85/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Is there a TI-85 calculator available online for free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. SciCalc Online offers a free TI-85 calculator simulator that runs in your browser. It provides scientific functions including trigonometry, logarithms, statistics, and more — no download required. Note: This is an independently developed tool, not an official Texas Instruments product.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the difference between TI-85 and TI-84?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The TI-85 was an earlier advanced scientific/graphing calculator from Texas Instruments, popular in the 1990s for engineering and college courses. The TI-84 Plus is the modern successor with a larger screen, USB connectivity, and app support. Both are graphing calculators, but the TI-84 is more widely used today.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can the TI-85 do complex numbers?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. The TI-85 supports complex number arithmetic, which made it popular for engineering courses. Our simulator currently supports the core scientific functions, with complex number support planned for a future update.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is the TI-85 still used in schools?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'While the TI-85 has been discontinued, many students and professionals still use them or seek online simulators for coursework compatibility. The TI-85 remains popular among engineering students who inherited one or prefer its interface. Our free online simulator lets you use TI-85-style functions without needing the physical device.',
        },
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  alternates={[
    { lang: 'en', url: 'https://scientificcalc.org/ti-85/' },
    { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-85/' },
  ]}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Hero -->
    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        TI-85 Calculator Online <span class="text-primary">Free</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Free online TI-85 calculator simulator with advanced scientific functions.
        Trigonometry, logarithms, statistics, and more — right in your browser.
      </p>
      <p class="text-[10px] text-text-muted/50 mt-2 italic">
        Not affiliated with Texas Instruments. This is an independently developed simulator.
      </p>
    </div>

    <!-- Calculator + Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti85} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Keyboard Shortcuts</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Number keys</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ - * /</kbd> Operations</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Enter</kbd> Calculate</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Backspace</kbd> Delete</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Esc</kbd> Clear all</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">( )</kbd> Parentheses</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">^</kbd> Exponent</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">TI-85 Features</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Advanced scientific functions</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trig functions (DEG/RAD/GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Logarithmic & exponential</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Absolute value</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Statistics (1-Var, 2-Var)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Table mode</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Memory (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mobile responsive</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Keyboard shortcuts</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> No download required</li>
          </ul>
        </div>

        <!-- Cross-link to other calculators -->
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Other Calculators</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li>
              <a href="/" class="text-primary hover:underline">TI-30XS Scientific Calculator</a>
              <span class="block text-xs text-text-muted/70">Scientific calculator for GED/SAT</span>
            </li>
            <li>
              <a href="/ti-84/" class="text-primary hover:underline">TI-84 Graphing Calculator</a>
              <span class="block text-xs text-text-muted/70">Graphing calculator for SAT/AP</span>
            </li>
            <li>
              <a href="/calculators/" class="text-primary hover:underline">View All Calculators</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- SEO Content Section -->
    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Free TI-85 Calculator Online</h2>
      <div class="text-text-muted space-y-4">
        <p>
          Looking for a <strong class="text-text">TI-85 calculator online</strong>? This free calculator
          simulator brings the TI-85's advanced scientific functionality to your web browser. Whether you're
          working through engineering homework or need a quick scientific calculation, this tool has you covered.
        </p>
        <p>
          The TI-85 was one of the most popular advanced scientific calculators for college students,
          especially in <strong class="text-text">engineering and physics courses</strong>. While the physical
          calculator has been discontinued, our simulator lets you use TI-85-style functions —
          <strong class="text-text">completely free, no download needed</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">What Can This TI-85 Calculator Do?</h3>
        <p>
          This online TI-85 calculator simulator supports the core scientific operations:
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Scientific Functions</strong> — All the math functions you need: powers, roots, logarithms, and exponentials</li>
          <li><strong class="text-text">Trigonometry</strong> — sin, cos, tan and their inverses in DEG, RAD, or GRAD mode</li>
          <li><strong class="text-text">Logarithms</strong> — Natural log (ln), common log (log), and base-10/e exponentials</li>
          <li><strong class="text-text">Absolute Value</strong> — Built-in absolute value function</li>
          <li><strong class="text-text">Statistics</strong> — 1-variable and 2-variable data analysis</li>
          <li><strong class="text-text">Table Mode</strong> — Generate x-y tables from any function</li>
          <li><strong class="text-text">Memory</strong> — Store and recall values in 7 memory variables</li>
          <li><strong class="text-text">Combinatorics</strong> — Permutations (nPr) and combinations (nCr)</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-85 vs TI-84: What's the Difference?</h3>
        <p>
          The <strong class="text-text">TI-85</strong> was Texas Instruments' advanced graphing calculator released in 1992,
          aimed at engineering and college-level math. The <strong class="text-text">TI-84 Plus</strong> is the current
          mainstream graphing calculator. Key differences:
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li>The TI-85 had a focus on engineering applications and complex number support</li>
          <li>The TI-84 has a larger screen, USB connectivity, and downloadable apps</li>
          <li>The TI-84 is more widely supported on standardized tests today</li>
          <li>Both are graphing calculators, but the TI-85 emphasized scientific computing</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">Who Uses the TI-85?</h3>
        <p>
          The TI-85 remains popular among <strong class="text-text">engineering students</strong>, professionals who
          learned on it, and anyone who prefers its interface for scientific calculations. Many students search
          for a TI-85 online when they need quick access to its functions without the physical device.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Works on Any Device</h3>
        <p>
          This calculator works on <strong class="text-text">desktop computers, laptops, tablets, and smartphones</strong>.
          It's fully responsive and supports both touch and keyboard input.
        </p>

        <!-- Disclaimer -->
        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Disclaimer:</strong> This is an independently developed scientific calculator simulator.
          It is not made by, endorsed by, or affiliated with Texas Instruments Incorporated.
          TI-85 and TI-84 are trademarks of Texas Instruments Incorporated,
          used here solely to describe the type of coursework this tool is designed to support
          (<a href="https://en.wikipedia.org/wiki/Nominative_use" class="underline hover:text-text">nominative fair use</a>).
          This simulator was built from scratch and does not contain any Texas Instruments software, firmware, or code.
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">
            Is there a TI-85 calculator available online for free?
            <span class="text-text-muted group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-text-muted text-sm">
            Yes! This free online TI-85 calculator simulator provides scientific functions
            including trigonometry, logarithms, statistics, and more — all in your web browser
            with no download required.
            <em class="block mt-1 text-xs opacity-70">Note: This is an independently developed tool, not an official Texas Instruments product.</em>
          </p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">
            What is the difference between TI-85 and TI-84?
            <span class="text-text-muted group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-text-muted text-sm">
            The TI-85 was an earlier advanced scientific/graphing calculator popular in engineering courses.
            The TI-84 Plus is the modern successor with a larger screen and USB connectivity.
            Both are graphing calculators, but the TI-84 is more widely used today.
          </p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">
            Can the TI-85 do complex numbers?
            <span class="text-text-muted group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-text-muted text-sm">
            The physical TI-85 supports complex number arithmetic, which made it popular for engineering.
            Our simulator currently supports core scientific functions, with complex number support
            planned for a future update.
          </p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">
            Is the TI-85 still used in schools?
            <span class="text-text-muted group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-text-muted text-sm">
            While the TI-85 has been discontinued, many students and professionals still seek
            online simulators for coursework compatibility. This free online simulator lets you use
            TI-85-style functions without needing the physical device.
          </p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
