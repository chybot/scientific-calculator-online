---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { ti30xa } from '../../calculators/ti-30xa';

const title = 'Calculadora TI-30XA en Línea Gratis — Simulador Científico (2026)';
const description = 'Calculadora TI-30XA en línea gratuita. Calculadora científica de una línea con fracciones, trigonometría, logaritmos y estadísticas. Sin descarga — funciona en ordenador y móvil.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-30xa/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-30xa/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-30xa/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulador de Calculadora TI-30XA',
    description: 'Simulador gratuito en línea de la calculadora científica TI-30XA con pantalla de una línea, fracciones, trigonometría, logaritmos y estadísticas.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/es/ti-30xa/',
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculadora TI-30XA', item: 'https://scientificcalc.org/es/ti-30xa/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: [
      { '@type': 'Question', name: '¿Existe una calculadora TI-30XA en línea gratis?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Este simulador gratuito de la calculadora científica TI-30XA funciona en tu navegador. Soporta el mismo conjunto de teclas que la TI-30XA física: fracciones, trigonometría, logaritmos, estadísticas, notación científica y memoria. Sin descarga, sin registro. Nota: Esta es una herramienta desarrollada independientemente, no un producto oficial de Texas Instruments.' } },
      { '@type': 'Question', name: '¿Puede la TI-30XA hacer fracciones?', acceptedAnswer: { '@type': 'Answer', text: 'Sí — pulsa la tecla a b/c entre el numerador y el denominador. Para números mixtos: entero → a b/c → numerador → a b/c → denominador. Pulsa 2nd y luego d/c para alternar entre fracción impropia y número mixto.' } },
      { '@type': 'Question', name: '¿En qué exámenes está permitida la TI-30XA?', acceptedAnswer: { '@type': 'Answer', text: 'La TI-30XA física está aprobada para el SAT, ACT, PSAT, AP, GED y la mayoría de exámenes estandarizados. Para el examen real necesitas la calculadora física; este simulador es para práctica y tareas.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="es" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-30xa" lang="es" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculadora TI-30XA en Línea <span class="text-primary">Gratis</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulador gratuito en línea de la calculadora científica básica TI-30XA. Pantalla de una línea,
        fracciones (a b/c), trigonometría, logaritmos y estadísticas — directamente en tu navegador.
      </p>
      <p class="text-[11px] text-text-muted/70 mt-2 italic">
        No afiliado a Texas Instruments. Simulador desarrollado independientemente.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti30xa} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Atajos de Teclado</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Números</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Operaciones</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Enter</kbd> Calcular</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Esc</kbd> Borrar todo</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Funciones</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Pantalla de una línea</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Tecla de fracciones (a b/c)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Modos DEG / RAD / GRAD</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonometría e inversas</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> log / ln / 10^x / e^x</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Notación científica (EE)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Estadística 1-Var y 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Memoria STO / RCL</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible con móvil</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sin descarga</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Otras Calculadoras</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/es/ti-30xs/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/es/ti-30xiis/" class="text-primary hover:underline">TI-30X IIS</a></li>
            <li><a href="/es/ti-84/" class="text-primary hover:underline">TI-84 Plus</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculadora Científica TI-30XA en Línea Gratis</h2>
      <div class="text-text-muted space-y-4">
        <p>
          Esta es una <strong class="text-text">calculadora TI-30XA en línea</strong> gratuita — un simulador
          de navegador que sigue la disposición de teclas de una línea de la TI-30XA. Úsala para
          <strong class="text-text">álgebra, geometría, trigonometría, química, física y preparación del GED</strong>.
          Soporta el flujo estándar de la TI-30XA: <strong class="text-text">entrada de fracciones a b/c, notación
          científica EE, cambio de modo DRG</strong>, log / ln y estadísticas de 2 variables.
        </p>
        <p>
          La <strong class="text-text">TI-30XA</strong> es la calculadora científica básica clásica de Texas
          Instruments, vendida desde 1996. Es un <strong class="text-text">estándar en las aulas</strong>: precio
          bajo, duradera y aprobada en prácticamente todos los exámenes estandarizados —
          <strong class="text-text">totalmente gratis, sin descarga</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">¿Qué puede hacer esta calculadora TI-30XA en línea?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Operaciones científicas</strong> — potencias, raíces, recíprocos, factoriales, π, e</li>
          <li><strong class="text-text">Fracciones</strong> — entrada a b/c, conversión impropia / mixta, alternar fracción-decimal</li>
          <li><strong class="text-text">Trigonometría</strong> — sin, cos, tan e inversas en DEG / RAD / GRAD</li>
          <li><strong class="text-text">Hiperbólicas</strong> — sinh, cosh, tanh mediante la capa 2nd HYP</li>
          <li><strong class="text-text">Logaritmos y exponenciales</strong> — log, ln, 10^x, e^x</li>
          <li><strong class="text-text">Notación científica</strong> — tecla EE, visualización ENG opcional</li>
          <li><strong class="text-text">Estadística</strong> — 1-Var (media, σ, sx, Σx) y 2-Var (regresión)</li>
          <li><strong class="text-text">Memoria</strong> — STO / RCL hasta 7 variables</li>
          <li><strong class="text-text">Combinatoria</strong> — nPr y nCr</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-30XA vs TI-30XS MultiView</h3>
        <p>
          La <strong class="text-text">TI-30XA</strong> tiene una pantalla de una línea y usa el método de entrada
          de fracciones a b/c. La <strong class="text-text">TI-30XS MultiView</strong> muestra hasta cuatro líneas
          y representa las fracciones y exponentes en formato natural de libro de texto (MathPrint). Ambas son
          calculadoras científicas aprobadas para el GED. Si tu clase usa la TI-30XA, este simulador te ofrece el
          mismo flujo de teclas; si tu libro muestra fracciones apiladas, usa la
          <a href="/es/ti-30xs/" class="underline hover:text-text">TI-30XS MultiView</a>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Funciona en cualquier dispositivo</h3>
        <p>
          Esta calculadora funciona en <strong class="text-text">ordenadores, portátiles, tabletas y smartphones</strong>.
          Totalmente responsive y soporta entrada táctil y de teclado.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Aviso legal:</strong> Este es un simulador de calculadora científica desarrollado independientemente.
          No está fabricado por, respaldado por, ni afiliado a Texas Instruments Incorporated.
          TI-30XA y TI-30XS MultiView son marcas registradas de Texas Instruments Incorporated,
          utilizadas aquí solo con fines descriptivos
          (uso referencial, art. 14 RMUE). Este simulador se desarrolló desde cero y no contiene software, firmware ni código de Texas Instruments.
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Existe una calculadora TI-30XA en línea gratis?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. Este simulador gratuito de TI-30XA funciona completamente en tu navegador — sin instalación, sin registro. Soporta las mismas funciones científicas que la TI-30XA física: fracciones, trigonometría, logaritmos, estadísticas y memoria.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Puede la TI-30XA hacer fracciones?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. Usa la tecla a b/c entre el numerador y el denominador. Para números mixtos: entero → a b/c → numerador → a b/c → denominador. Pulsa 2nd y luego d/c para alternar entre forma mixta e impropia.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿En qué exámenes está permitida la TI-30XA?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La TI-30XA física está aprobada para el SAT, ACT, PSAT, AP, GED y casi todos los exámenes estandarizados. Para el examen real, lleva la calculadora física; los simuladores en línea nunca se permiten durante el examen.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
