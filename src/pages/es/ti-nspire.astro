---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { tiNspire } from '../../calculators/ti-nspire';

const title = 'Calculadora TI-Nspire en Línea Gratis — Simulador CX II (2026)';
const description = 'Calculadora TI-Nspire CX II en línea gratuita. Funciones científicas, trigonometría, logaritmos, estadísticas y modo tabla. Sin descarga — funciona en ordenador y móvil.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-nspire/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-nspire/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-nspire/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulador de Calculadora TI-Nspire CX',
    description: 'Simulador gratuito en línea de la calculadora TI-Nspire CX II con funciones científicas, trigonometría, estadísticas y modo tabla.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/es/ti-nspire/',
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculadora TI-Nspire', item: 'https://scientificcalc.org/es/ti-nspire/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: [
      { '@type': 'Question', name: '¿Existe una calculadora TI-Nspire en línea gratis?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Este simulador gratuito de TI-Nspire CX funciona en tu navegador — sin descarga. Soporta los flujos científicos, trigonométricos y estadísticos que necesitas para cálculo, estadística, IB Math y la preparación del SAT. Nota: Es un simulador desarrollado independientemente, no un producto oficial de Texas Instruments, y no incluye el sistema de documentos del TI-Nspire OS físico.' } },
      { '@type': 'Question', name: '¿Cuál es la diferencia entre la TI-Nspire CX II y la CX II CAS?', acceptedAnswer: { '@type': 'Answer', text: 'La versión CAS (sistema de álgebra computacional) puede resolver ecuaciones de forma simbólica (factorizar, expandir, resolver, integrales simbólicas). La versión no CAS es solo numérica. La CAS no está permitida en el ACT, pero sí en el SAT y los exámenes AP.' } },
      { '@type': 'Question', name: '¿Funciona este simulador en mi teléfono?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. El simulador es totalmente responsive y funciona en iPhone, Android, iPad, Chromebook y todos los navegadores de escritorio.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="es" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-nspire" lang="es" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculadora TI-Nspire en Línea <span class="text-primary">Gratis</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulador gratuito en línea de la calculadora gráfica a color TI-Nspire CX II. Funciones científicas,
        trigonometría, estadísticas y modo tabla — directamente en tu navegador.
      </p>
      <p class="text-[10px] text-text-muted/50 mt-2 italic">
        No afiliado a Texas Instruments. Simulador desarrollado independientemente.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={tiNspire} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Atajos de Teclado</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Números</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Operaciones</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Enter</kbd> Calcular</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Esc</kbd> Borrar todo</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Funciones</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Teclas 2nd / menu / plantillas</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Modos DEG / RAD / GRAD</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Pantalla matemática natural</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonometría e inversas</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> log / ln / 10^x / e^x</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Estadística 1-Var y 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Modo tabla</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Memoria STO→ / RCL (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible con móvil</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sin descarga</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Otras Calculadoras</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/es/ti-30xs/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/es/ti-84/" class="text-primary hover:underline">TI-84 Plus</a></li>
            <li><a href="/es/ti-85/" class="text-primary hover:underline">TI-85</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculadora TI-Nspire CX II en Línea Gratis</h2>
      <div class="text-text-muted space-y-4">
        <p>
          La <strong class="text-text">TI-Nspire CX II</strong> es la calculadora gráfica a color insignia de
          Texas Instruments — pantalla a color de alta resolución, flujo de documentos y páginas, geometría
          dinámica y (en la versión CAS) un sistema de álgebra computacional. Esta
          <strong class="text-text">calculadora TI-Nspire en línea</strong> gratuita lleva los flujos científicos,
          trigonométricos, estadísticos y de tabla a tu navegador para que estudies desde cualquier dispositivo.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">¿Qué puede hacer esta calculadora TI-Nspire en línea?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Operaciones científicas</strong> — potencias, raíces, recíprocos, factoriales, notación científica</li>
          <li><strong class="text-text">Trigonometría</strong> — sin, cos, tan e inversas en DEG / RAD / GRAD</li>
          <li><strong class="text-text">Logaritmos y exponenciales</strong> — log, ln, 10^x, e^x</li>
          <li><strong class="text-text">Estadística</strong> — análisis de 1 y 2 variables con regresión en el panel STAT</li>
          <li><strong class="text-text">Modo tabla</strong> — escribe f(x) y genera una tabla x-y como en la app TABLE de la Nspire</li>
          <li><strong class="text-text">Memoria STO→ / RCL</strong> — 7 variables (x, y, z, t, a, b, c)</li>
          <li><strong class="text-text">Combinatoria</strong> — nPr y nCr desde la capa 2nd</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-Nspire CX II vs TI-Nspire CX II CAS</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">TI-Nspire CX II</strong> — solo numérica. Permitida en el SAT, ACT, AP e IB. La elección de la mayoría de institutos.</li>
          <li><strong class="text-text">TI-Nspire CX II CAS</strong> — añade álgebra simbólica (factorizar, expandir, resolver, integrales simbólicas). Permitida en el SAT y AP. <strong>No</strong> permitida en el ACT.</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-Nspire CX II vs TI-84 Plus</h3>
        <p>
          La <strong class="text-text">TI-Nspire CX II</strong> tiene una pantalla a color más nítida, un sistema
          de documentos y páginas, gráficos interactivos y más memoria. La <strong class="text-text">TI-84 Plus</strong>
          tiene menús más simples y una curva de aprendizaje más corta, y es más común en los institutos. Para
          cálculo avanzado e IB Math muchos profesores prefieren la Nspire; para el SAT y álgebra II, la TI-84 es suficiente.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Qué no incluye el simulador de navegador</h3>
        <p>
          El simulador no incluye el sistema de documentos y páginas de la TI-Nspire, la geometría dinámica, la hoja
          de cálculo, los gráficos a color, el editor de Python ni el motor simbólico CAS. Para todos los flujos
          científicos y estadísticos usados en tareas y preparación de exámenes, este simulador es suficiente.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Funciona en cualquier dispositivo</h3>
        <p>
          Esta calculadora funciona en <strong class="text-text">ordenadores, portátiles, tabletas y smartphones</strong>.
          Totalmente responsive y soporta entrada táctil y de teclado.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Aviso legal:</strong> Este es un simulador de calculadora desarrollado independientemente.
          No está fabricado por, respaldado por, ni afiliado a Texas Instruments Incorporated.
          TI-Nspire, TI-Nspire CX, TI-Nspire CX II y TI-84 Plus CE son marcas registradas de Texas Instruments Incorporated,
          utilizadas aquí solo con fines descriptivos
          (<a href="https://es.wikipedia.org/wiki/Uso_nominativo" class="underline hover:text-text">uso nominativo</a>).
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Existe una calculadora TI-Nspire en línea gratis?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. Este simulador gratuito de TI-Nspire CX funciona en tu navegador — sin descarga. Cubre los flujos científicos, trigonométricos, estadísticos y de tabla. El sistema de documentos y el CAS no se incluyen en la versión de navegador.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Cuál es la diferencia entre la CX II y la CX II CAS?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La versión CAS resuelve ecuaciones de forma simbólica (factorizar, expandir, integrales simbólicas); la no CAS es solo numérica. La CAS no está permitida en el ACT, pero sí en el SAT y los exámenes AP.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Funciona en mi teléfono?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. El simulador es totalmente responsive y funciona en cualquier smartphone, tableta o ordenador con un navegador moderno.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
