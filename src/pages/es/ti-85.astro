---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { ti85 } from '../../calculators/ti-85';

const title = 'Calculadora TI-85 en Línea Gratis — Simulador Científico (2026)';
const description = 'Calculadora TI-85 en línea gratuita. Funciones científicas avanzadas, trigonometría, logaritmos, estadísticas. Sin descarga — funciona en ordenador y móvil.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-85/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-85/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-85/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulador de Calculadora TI-85',
    description: 'Simulador gratuito en línea de la calculadora científica TI-85 con funciones avanzadas, trigonometría, logaritmos y estadísticas.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/es/ti-85/',
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculadora TI-85', item: 'https://scientificcalc.org/es/ti-85/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: [
      { '@type': 'Question', name: '¿Existe una calculadora TI-85 en línea gratis?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. SciCalc Online ofrece un simulador gratuito de la calculadora científica TI-85 accesible desde cualquier navegador. Soporta trigonometría, logaritmos, estadísticas y más — sin descarga, sin registro. Nota: Esta es una herramienta desarrollada independientemente, no un producto oficial de Texas Instruments.' } },
      { '@type': 'Question', name: '¿Cuál es la diferencia entre la TI-85 y la TI-84?', acceptedAnswer: { '@type': 'Answer', text: 'La TI-85 fue una calculadora gráfica avanzada de los años 90, popular en cursos de ingeniería y por su soporte de números complejos. La TI-84 Plus es el modelo moderno con pantalla más grande y puerto USB. Ambas son calculadoras gráficas, pero la TI-84 es más utilizada hoy en día.' } },
      { '@type': 'Question', name: '¿Funciona este simulador en mi teléfono?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. El simulador es totalmente responsive y funciona en iPhone, Android, iPad, tabletas y todos los navegadores de escritorio.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="es" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-85" lang="es" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculadora TI-85 en Línea <span class="text-primary">Gratis</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulador gratuito en línea de la calculadora científica TI-85 con funciones avanzadas:
        trigonometría, logaritmos, estadísticas — directamente en tu navegador.
      </p>
      <p class="text-[11px] text-text-muted/70 mt-2 italic">
        No afiliado a Texas Instruments. Simulador desarrollado independientemente.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti85} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Atajos de Teclado</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Números</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Operaciones</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Enter</kbd> Calcular</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Esc</kbd> Borrar todo</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Funciones</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Funciones científicas avanzadas</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonometría (DEG / RAD / GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Logaritmos y exponenciales</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Valor absoluto</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Estadística 1-Var y 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Modo tabla</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Memoria (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible con móvil</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sin descarga</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Otras Calculadoras</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/es/ti-30xs/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/es/ti-84/" class="text-primary hover:underline">TI-84 Plus</a></li>
            <li><a href="/es/ti-nspire/" class="text-primary hover:underline">TI-Nspire CX</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculadora TI-85 en Línea Gratis</h2>
      <div class="text-text-muted space-y-4">
        <p>
          ¿Buscas una <strong class="text-text">calculadora TI-85 en línea</strong>? Este simulador gratuito
          recrea las funciones científicas avanzadas de la TI-85 directamente en tu navegador. Ideal para
          estudiantes de <strong class="text-text">ingeniería, física y matemáticas</strong>.
        </p>
        <p>
          La <strong class="text-text">TI-85</strong> fue una de las calculadoras científicas más populares
          entre estudiantes universitarios, especialmente en cursos de <strong class="text-text">ingeniería y
          física</strong>. Aunque la calculadora física ya no se fabrica, este simulador te permite usar sus
          funciones — <strong class="text-text">totalmente gratis, sin descarga</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">¿Qué puede hacer esta calculadora TI-85?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Funciones científicas</strong> — potencias, raíces, logaritmos, exponenciales</li>
          <li><strong class="text-text">Trigonometría</strong> — sin, cos, tan e inversas en modo DEG / RAD / GRAD</li>
          <li><strong class="text-text">Logaritmos</strong> — log natural (ln), log común (log), e^x y 10^x</li>
          <li><strong class="text-text">Valor absoluto</strong> — función de valor absoluto integrada</li>
          <li><strong class="text-text">Estadística</strong> — análisis de datos de 1 y 2 variables</li>
          <li><strong class="text-text">Modo tabla</strong> — generar tablas x-y desde una función</li>
          <li><strong class="text-text">Memoria</strong> — almacenar y recuperar 7 variables</li>
          <li><strong class="text-text">Combinatoria</strong> — permutaciones (nPr) y combinaciones (nCr)</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-85 vs TI-84: ¿Cuál es la diferencia?</h3>
        <p>
          La <strong class="text-text">TI-85</strong> fue la calculadora gráfica avanzada de Texas Instruments
          lanzada en 1992, orientada a las matemáticas de ingeniería y de nivel universitario. La
          <strong class="text-text">TI-84 Plus</strong> es la calculadora gráfica más extendida en la actualidad.
          Diferencias principales:
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li>La TI-85 ponía el énfasis en aplicaciones de ingeniería y números complejos</li>
          <li>La TI-84 tiene una pantalla más grande, puerto USB y aplicaciones descargables</li>
          <li>La TI-84 está más aceptada hoy en los exámenes estandarizados</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">Funciona en cualquier dispositivo</h3>
        <p>
          Esta calculadora funciona en <strong class="text-text">ordenadores, portátiles, tabletas y smartphones</strong>.
          Totalmente responsive y soporta entrada táctil y de teclado.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Aviso legal:</strong> Este es un simulador de calculadora científica desarrollado independientemente.
          No está fabricado por, respaldado por, ni afiliado a Texas Instruments Incorporated.
          TI-85 y TI-84 son marcas registradas de Texas Instruments Incorporated,
          utilizadas aquí solo con fines descriptivos
          (uso referencial, art. 14 RMUE). Este simulador se desarrolló desde cero y no contiene software, firmware ni código de Texas Instruments.
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Existe una calculadora TI-85 en línea gratis?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. Este simulador gratuito de TI-85 ofrece las funciones científicas — trigonometría, logaritmos, estadística — directamente en tu navegador, sin descarga.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Cuál es la diferencia entre la TI-85 y la TI-84?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La TI-85 fue una calculadora científica/gráfica avanzada popular en cursos de ingeniería. La TI-84 Plus es la sucesora moderna con pantalla más grande y puerto USB.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Funciona en mi teléfono?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. El simulador es totalmente responsive y funciona en cualquier smartphone, tableta o ordenador con un navegador moderno.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
