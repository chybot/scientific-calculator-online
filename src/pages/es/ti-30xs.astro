---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';

const title = 'Calculadora TI-30XS en Línea Gratis — Simulador Científico (2026)';
const description = 'Calculadora TI-30XS MultiView en línea gratuita. Pantalla MathPrint, fracciones, trigonometría, estadísticas, modo tabla. Sin descarga — funciona en ordenador y móvil.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-30xs/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulador de Calculadora TI-30XS',
    description: 'Simulador gratuito en línea de la calculadora científica TI-30XS MultiView con pantalla natural, fracciones, trigonometría y estadísticas.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/es/ti-30xs/',
    inLanguage: 'es',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculadora TI-30XS', item: 'https://scientificcalc.org/es/ti-30xs/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: [
      { '@type': 'Question', name: '¿Existe una calculadora TI-30XS en línea gratis?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. SciCalc Online ofrece un simulador gratuito de la calculadora científica TI-30XS MultiView accesible desde cualquier navegador. Sin descarga, sin registro. Nota: Esta es una herramienta desarrollada independientemente, no un producto oficial de Texas Instruments.' } },
      { '@type': 'Question', name: '¿Puedo usar esta calculadora en el móvil?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. El simulador es totalmente responsive y funciona en iPhone, Android, iPad, Chromebook y todos los navegadores de escritorio.' } },
      { '@type': 'Question', name: '¿Para qué exámenes está permitida la TI-30XS?', acceptedAnswer: { '@type': 'Answer', text: 'La TI-30XS MultiView física está aprobada para GED, SAT, ACT, PSAT, AP y la mayoría de exámenes estandarizados. Para el examen real necesitas la calculadora física; este simulador es para práctica y tareas.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="es" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculadora TI-30XS en Línea <span class="text-primary">Gratis</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulador gratuito en línea de la calculadora científica TI-30XS MultiView. Pantalla natural,
        fracciones, trigonometría, estadísticas y modo tabla — directamente en tu navegador.
      </p>
      <p class="text-[10px] text-text-muted/50 mt-2 italic">
        No afiliado con Texas Instruments. Simulador desarrollado independientemente.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Atajos de Teclado</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Números</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Operaciones</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Enter</kbd> Calcular</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Esc</kbd> Borrar todo</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Funciones</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Pantalla MathPrint natural</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Entrada de fracciones</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonometría (DEG / RAD / GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Logaritmos y exponenciales</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Estadística 1-Var y 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Modo tabla</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Memoria (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible con móvil</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sin descarga</li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculadora TI-30XS MultiView en Línea Gratis</h2>
      <div class="text-text-muted space-y-4">
        <p>
          ¿Buscas una <strong class="text-text">calculadora TI-30XS en línea</strong>? Este simulador gratuito de
          calculadora científica está diseñado para estudiantes que usan la TI-30XS MultiView en sus cursos de
          <strong class="text-text">matemáticas, ciencias y estadística</strong>. Ofrece las mismas funciones
          científicas — todo en tu navegador web.
        </p>
        <p>
          Ya sea que estés preparándote para el <strong class="text-text">GED</strong>, el
          <strong class="text-text">SAT</strong>, o trabajando en tus tareas de matemáticas, esta calculadora
          en línea te brinda la funcionalidad científica que necesitas —
          <strong class="text-text">totalmente gratis, sin descarga</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">¿Qué puede hacer esta calculadora?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Pantalla natural</strong> — fracciones, exponentes y raíces en formato natural</li>
          <li><strong class="text-text">Fracciones</strong> — introducir, simplificar y convertir fracciones</li>
          <li><strong class="text-text">Trigonometría</strong> — sin, cos, tan e inversas en modo DEG / RAD / GRAD</li>
          <li><strong class="text-text">Logaritmos</strong> — log natural (ln), log común (log), exponenciales</li>
          <li><strong class="text-text">Estadística</strong> — análisis de 1 y 2 variables</li>
          <li><strong class="text-text">Modo tabla</strong> — generar tablas x-y desde una función</li>
          <li><strong class="text-text">Memoria</strong> — almacenar y recuperar valores</li>
          <li><strong class="text-text">Combinatoria</strong> — permutaciones (nPr) y combinaciones (nCr)</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-30XS vs TI-84: ¿Cuál es la diferencia?</h3>
        <p>
          La <strong class="text-text">TI-30XS MultiView</strong> es una calculadora científica, mientras que la
          <strong class="text-text">TI-84</strong> es una calculadora gráfica. La TI-30XS es más asequible, está
          permitida en más exámenes estandarizados, y maneja todas las matemáticas que necesitas para álgebra,
          geometría, trigonometría y estadística. La TI-84 añade capacidades gráficas necesarias para precálculo y cálculo.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Funciona en cualquier dispositivo</h3>
        <p>
          Esta calculadora funciona en <strong class="text-text">ordenadores, portátiles, tabletas y smartphones</strong>.
          Totalmente responsive y soporta entrada táctil y de teclado.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Aviso legal:</strong> Este es un simulador de calculadora científica desarrollado independientemente.
          No está fabricado por, respaldado por, ni afiliado a Texas Instruments Incorporated.
          TI-30XS MultiView, TI-84 y MathPrint son marcas registradas de Texas Instruments Incorporated,
          utilizadas aquí solo con fines descriptivos
          (<a href="https://es.wikipedia.org/wiki/Uso_nominativo" class="underline hover:text-text">uso nominativo</a>).
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Preguntas Frecuentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Existe una calculadora TI-30XS en línea gratis?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. Este simulador gratuito de TI-30XS MultiView ofrece las funciones científicas — fracciones, trigonometría, estadística — directamente en tu navegador, sin descarga.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Funciona en el móvil?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Sí. El simulador es totalmente responsive y funciona en cualquier smartphone, tableta o ordenador con un navegador moderno.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">¿Para qué exámenes está permitida la TI-30XS?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La TI-30XS MultiView física está aprobada para GED, PSAT, SAT, ACT, AP y la mayoría de exámenes estandarizados. Para el examen real, lleva la calculadora física.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
