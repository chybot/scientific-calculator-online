---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { ti30xa } from '../../calculators/ti-30xa';

const title = 'Calculatrice TI-30XA en Ligne Gratuite — Simulateur Scientifique Basique (2026)';
const description = 'Calculatrice TI-30XA en ligne gratuite. Calculatrice scientifique basique à une ligne : fractions (a b/c), trigonométrie, logarithmes, statistiques. Sans téléchargement, sur ordinateur et mobile.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-30xa/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-30xa/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-30xa/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulateur de Calculatrice TI-30XA',
    description: 'Simulateur gratuit en ligne de la calculatrice scientifique TI-30XA — affichage une ligne, fractions, trigonométrie, logarithmes, statistiques.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/fr/ti-30xa/',
    inLanguage: 'fr',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculatrice TI-30XA', item: 'https://scientificcalc.org/fr/ti-30xa/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: [
      { '@type': 'Question', name: 'Existe-t-il une calculatrice TI-30XA en ligne gratuite ?', acceptedAnswer: { '@type': 'Answer', text: "Oui. Ce simulateur gratuit de la calculatrice scientifique TI-30XA fonctionne dans votre navigateur. Il prend en charge les fractions, la trigonométrie, les logarithmes, les statistiques, la notation scientifique et les variables mémoire — sans téléchargement, sans compte. Remarque : ceci est un outil développé indépendamment, pas un produit officiel Texas Instruments." } },
      { '@type': 'Question', name: 'Quelle est la différence entre la TI-30XA et la TI-30XS MultiView ?', acceptedAnswer: { '@type': 'Answer', text: "La TI-30XA a un affichage à une seule ligne et utilise la touche a b/c pour saisir les fractions. La TI-30XS MultiView affiche jusqu'à quatre lignes et présente les fractions et exposants au format manuel scolaire (MathPrint). Les deux sont des calculatrices scientifiques ; la TI-30XS est plus récente, la TI-30XA est un classique des salles de classe." } },
      { '@type': 'Question', name: 'La TI-30XA peut-elle calculer des fractions ?', acceptedAnswer: { '@type': 'Answer', text: "Oui — appuyez sur la touche a b/c entre le numérateur et le dénominateur. Pour les nombres mixtes, saisissez la partie entière, a b/c, le numérateur, a b/c, le dénominateur. Appuyez sur 2nd puis d/c pour basculer entre fraction impropre et nombre mixte." } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="fr" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-30xa" lang="fr" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculatrice TI-30XA en Ligne <span class="text-primary">Gratuite</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulateur gratuit en ligne de la calculatrice scientifique basique TI-30XA : affichage une ligne,
        fractions (a b/c), trigonométrie, logarithmes et statistiques — directement dans votre navigateur.
      </p>
      <p class="text-[11px] text-text-muted/70 mt-2 italic">
        Non affilié à Texas Instruments. Simulateur développé indépendamment.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti30xa} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Raccourcis Clavier</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Chiffres</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Opérations</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Entrée</kbd> Calculer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Retour</kbd> Effacer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Échap</kbd> Tout effacer</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Fonctionnalités</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Affichage à une ligne</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Touche fraction (a b/c)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonométrie (DEG / RAD / GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> log / ln / 10^x / e^x</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Notation scientifique (EE)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Statistiques 1-Var et 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mémoire STO / RCL</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible mobile</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sans téléchargement</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Autres Calculatrices</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/fr/ti-30xs/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/fr/ti-30xiis/" class="text-primary hover:underline">TI-30X IIS</a></li>
            <li><a href="/fr/ti-84/" class="text-primary hover:underline">TI-84 Plus</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculatrice TI-30XA en Ligne Gratuite</h2>
      <div class="text-text-muted space-y-4">
        <p>
          Vous cherchez une <strong class="text-text">calculatrice TI-30XA en ligne</strong> ? Ce simulateur gratuit
          suit la disposition de touches à une ligne de la TI-30XA. Utilisez-le pour
          l'<strong class="text-text">algèbre, la géométrie, la trigonométrie, la chimie et la physique</strong> :
          saisie de fractions a b/c, notation scientifique EE, modes DEG / RAD / GRAD, log / ln et statistiques à
          deux variables.
        </p>
        <p>
          La <strong class="text-text">TI-30XA</strong> est la calculatrice scientifique basique classique de Texas
          Instruments, vendue depuis 1996 : peu coûteuse, robuste et présente dans d'innombrables salles de classe.
          Ce simulateur vous donne le même flux de touches —
          <strong class="text-text">complètement gratuit, sans téléchargement</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Que peut faire cette calculatrice TI-30XA ?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Fonctions scientifiques</strong> — puissances, racines, inverses, factorielles, π, e</li>
          <li><strong class="text-text">Fractions</strong> — saisie a b/c, conversion impropre / mixte, bascule fraction-décimal</li>
          <li><strong class="text-text">Trigonométrie</strong> — sin, cos, tan et inverses en DEG / RAD / GRAD</li>
          <li><strong class="text-text">Hyperboliques</strong> — sinh, cosh, tanh via la couche 2nd HYP</li>
          <li><strong class="text-text">Logarithmes</strong> — log, ln, 10^x et e^x</li>
          <li><strong class="text-text">Notation scientifique</strong> — touche EE, affichage ENG optionnel</li>
          <li><strong class="text-text">Statistiques</strong> — 1-Var (moyenne, écart-type, Σx) et 2-Var (régression)</li>
          <li><strong class="text-text">Mémoire</strong> — STO / RCL jusqu'à 7 variables</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-30XA vs TI-30XS MultiView : Quelle est la différence ?</h3>
        <p>
          La <strong class="text-text">TI-30XA</strong> affiche une seule ligne et utilise la touche a b/c pour les
          fractions. La <strong class="text-text">TI-30XS MultiView</strong> affiche jusqu'à quatre lignes et
          présente les fractions au format manuel scolaire. Différences principales :
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li>La TI-30XS permet de modifier l'expression précédente ; la TI-30XA non</li>
          <li>La TI-30XS affiche les fractions empilées verticalement (MathPrint)</li>
          <li>La TI-30XA est plus compacte et reste un standard des salles de classe</li>
        </ul>
        <p>
          Si votre manuel affiche les fractions empilées, passez à la
          <a href="/fr/ti-30xs/" class="underline hover:text-text">TI-30XS MultiView</a>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Fonctionne sur tous les appareils</h3>
        <p>
          Cette calculatrice fonctionne sur <strong class="text-text">ordinateurs, ordinateurs portables, tablettes
          et smartphones</strong>. Entièrement responsive avec support tactile et clavier.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Avertissement :</strong> Ceci est un simulateur de calculatrice scientifique développé indépendamment.
          Il n'est pas fabriqué par, approuvé par, ou affilié à Texas Instruments Incorporated.
          TI-30XA et TI-30XS MultiView sont des marques déposées de Texas Instruments Incorporated, utilisées ici uniquement à des
          fins descriptives (usage référentiel, art. 14 RMUE). Ce simulateur a été développé à partir de zéro et ne contient aucun logiciel, micrologiciel ou code de Texas Instruments.
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Existe-t-il une calculatrice TI-30XA en ligne gratuite ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui ! Ce simulateur gratuit de TI-30XA fonctionne entièrement dans votre navigateur — sans installation ni inscription. Il prend en charge les fractions, la trigonométrie, les logarithmes, les statistiques et la mémoire.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Quelle est la différence entre la TI-30XA et la TI-30XS MultiView ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La TI-30XA affiche une seule ligne avec saisie de fractions a b/c. La TI-30XS MultiView affiche jusqu'à quatre lignes au format naturel. Si votre classe utilise la TI-30XA, restez ici ; sinon essayez la <a href="/fr/ti-30xs/" class="underline">TI-30XS MultiView</a>.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">La TI-30XA peut-elle calculer des fractions ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui. Utilisez la touche a b/c entre le numérateur et le dénominateur. Pour les nombres mixtes : entier → a b/c → numérateur → a b/c → dénominateur. Appuyez sur 2nd puis d/c pour basculer entre forme mixte et impropre.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
