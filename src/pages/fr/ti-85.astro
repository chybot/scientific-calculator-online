---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { ti85 } from '../../calculators/ti-85';

const title = 'Calculatrice TI-85 en Ligne Gratuite — Simulateur Scientifique (2026)';
const description = 'Calculatrice TI-85 en ligne gratuite. Fonctions scientifiques, trigonométrie, logarithmes, statistiques. Sans téléchargement, fonctionne sur ordinateur et mobile.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-85/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-85/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulateur de Calculatrice TI-85',
    description: 'Simulateur gratuit en ligne de la calculatrice scientifique TI-85 — fonctions avancées, trigonométrie, statistiques.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/fr/ti-85/',
    inLanguage: 'fr',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculatrice TI-85', item: 'https://scientificcalc.org/fr/ti-85/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: [
      { '@type': 'Question', name: "Existe-t-il une calculatrice TI-85 en ligne gratuite ?", acceptedAnswer: { '@type': 'Answer', text: "Oui. SciCalc Online propose un simulateur gratuit de la calculatrice scientifique TI-85, accessible depuis n'importe quel navigateur. Il prend en charge les fonctions trigonométriques, les logarithmes, les statistiques et plus encore — sans installation. Remarque : ceci est un outil développé indépendamment, pas un produit officiel Texas Instruments." } },
      { '@type': 'Question', name: 'Quelle est la différence entre la TI-85 et la TI-84 ?', acceptedAnswer: { '@type': 'Answer', text: "La TI-85 était une calculatrice graphique avancée des années 1990, populaire pour l'ingénierie et les nombres complexes. La TI-84 Plus est le modèle moderne avec écran plus grand et port USB. Les deux sont des calculatrices graphiques, mais la TI-84 est plus utilisée aujourd'hui." } },
      { '@type': 'Question', name: 'Ce simulateur fonctionne-t-il sur mon téléphone ?', acceptedAnswer: { '@type': 'Answer', text: 'Oui — le simulateur est entièrement responsive sur iPhone, Android, iPad, tablettes et tous les navigateurs de bureau.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="fr" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-85" lang="fr" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculatrice TI-85 en Ligne <span class="text-primary">Gratuite</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulateur gratuit en ligne de la calculatrice scientifique TI-85 avec fonctions avancées :
        trigonométrie, logarithmes, statistiques — directement dans votre navigateur.
      </p>
      <p class="text-[10px] text-text-muted/50 mt-2 italic">
        Non affilié à Texas Instruments. Simulateur développé indépendamment.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti85} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Raccourcis Clavier</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Chiffres</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Opérations</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Entrée</kbd> Calculer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Retour</kbd> Effacer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Échap</kbd> Tout effacer</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Fonctionnalités</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Fonctions scientifiques avancées</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonométrie (DEG / RAD / GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Logarithmes et exponentielles</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Statistiques 1-Var et 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mode tableau de fonctions</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mémoire (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible mobile</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sans téléchargement</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Autres Calculatrices</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/ti-84/" class="text-primary hover:underline">TI-84 Plus</a></li>
            <li><a href="/ti-nspire/" class="text-primary hover:underline">TI-Nspire CX</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculatrice TI-85 en Ligne Gratuite</h2>
      <div class="text-text-muted space-y-4">
        <p>
          Vous cherchez une <strong class="text-text">calculatrice TI-85 en ligne</strong> ? Ce simulateur gratuit
          recrée les fonctions scientifiques avancées de la TI-85 directement dans votre navigateur. Idéal pour
          les <strong class="text-text">étudiants en ingénierie, physique et mathématiques</strong>.
        </p>
        <p>
          La <strong class="text-text">TI-85</strong> a été l'une des calculatrices scientifiques les plus populaires
          pour les étudiants universitaires, en particulier dans les cours d'<strong class="text-text">ingénierie et
          de physique</strong>. Bien que la calculatrice physique ne soit plus produite, ce simulateur vous permet
          d'utiliser ses fonctions — <strong class="text-text">complètement gratuit, sans téléchargement</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Que peut faire cette calculatrice TI-85 ?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Fonctions scientifiques</strong> — puissances, racines, logarithmes, exponentielles</li>
          <li><strong class="text-text">Trigonométrie</strong> — sin, cos, tan et inverses en DEG / RAD / GRAD</li>
          <li><strong class="text-text">Logarithmes</strong> — log naturel (ln), log commun (log), e^x et 10^x</li>
          <li><strong class="text-text">Valeur absolue</strong> — fonction valeur absolue intégrée</li>
          <li><strong class="text-text">Statistiques</strong> — analyse de données à 1 et 2 variables</li>
          <li><strong class="text-text">Mode tableau</strong> — générer des tables x-y depuis une fonction</li>
          <li><strong class="text-text">Mémoire</strong> — stocker et rappeler 7 variables</li>
          <li><strong class="text-text">Combinatoires</strong> — Permutations (nPr) et combinaisons (nCr)</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-85 vs TI-84 : Quelle est la différence ?</h3>
        <p>
          La <strong class="text-text">TI-85</strong> est la calculatrice graphique avancée de Texas Instruments
          sortie en 1992, destinée aux mathématiques d'ingénierie et de niveau universitaire. La
          <strong class="text-text">TI-84 Plus</strong> est la calculatrice graphique grand public actuelle. Différences
          principales :
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li>La TI-85 mettait l'accent sur les applications d'ingénierie et les nombres complexes</li>
          <li>La TI-84 a un plus grand écran, port USB et applications téléchargeables</li>
          <li>La TI-84 est davantage acceptée aux examens standardisés aujourd'hui</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">Fonctionne sur tous les appareils</h3>
        <p>
          Cette calculatrice fonctionne sur <strong class="text-text">ordinateurs, ordinateurs portables, tablettes
          et smartphones</strong>. Entièrement responsive avec support tactile et clavier.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Avertissement :</strong> Ceci est un simulateur de calculatrice scientifique développé indépendamment.
          Il n'est pas fabriqué par, approuvé par, ou affilié à Texas Instruments Incorporated.
          TI-85 et TI-84 sont des marques déposées de Texas Instruments Incorporated, utilisées ici uniquement à des
          fins descriptives (<a href="https://fr.wikipedia.org/wiki/Usage_nominatif" class="underline hover:text-text">usage nominatif</a>).
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Existe-t-il une calculatrice TI-85 en ligne gratuite ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui ! Ce simulateur gratuit de TI-85 fournit les fonctions scientifiques — trigonométrie, logarithmes, statistiques — directement dans votre navigateur, sans téléchargement.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Quelle est la différence entre la TI-85 et la TI-84 ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La TI-85 était une calculatrice scientifique/graphique avancée populaire dans les cours d'ingénierie. La TI-84 Plus est le successeur moderne avec écran plus grand et port USB.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Fonctionne-t-il sur mon téléphone ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui. Le simulateur est entièrement responsive et fonctionne sur tous les smartphones, tablettes et navigateurs de bureau modernes.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
