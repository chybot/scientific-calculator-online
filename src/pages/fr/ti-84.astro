---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../../components/calculator/Calculator';
import CalculatorHub from '../../components/CalculatorHub.astro';
import { ti84 } from '../../calculators/ti-84';

const title = 'Calculatrice TI-84 Plus en Ligne Gratuite — Simulateur Graphique (2026)';
const description = 'Calculatrice TI-84 Plus en ligne gratuite. Simulateur graphique avec fonctions scientifiques, trigonométrie, statistiques, mode tableau. Sans téléchargement, fonctionne sur ordinateur et mobile.';

const alternates = [
  { lang: 'en', url: 'https://scientificcalc.org/ti-84/' },
  { lang: 'fr', url: 'https://scientificcalc.org/fr/ti-84/' },
  { lang: 'es', url: 'https://scientificcalc.org/es/ti-84/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'SciCalc Online — Simulateur de Calculatrice TI-84 Plus',
    description: 'Simulateur gratuit en ligne de la calculatrice graphique TI-84 Plus — fonctions scientifiques, statistiques, mode tableau.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web Browser',
    url: 'https://scientificcalc.org/fr/ti-84/',
    inLanguage: 'fr',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://scientificcalc.org/' },
      { '@type': 'ListItem', position: 2, name: 'Calculatrice TI-84 Plus', item: 'https://scientificcalc.org/fr/ti-84/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: [
      { '@type': 'Question', name: 'Existe-t-il une calculatrice TI-84 Plus en ligne gratuite ?', acceptedAnswer: { '@type': 'Answer', text: "Oui. SciCalc Online propose un simulateur gratuit de la calculatrice TI-84 Plus qui fonctionne dans votre navigateur. Il couvre les fonctions scientifiques, statistiques et le mode tableau — sans téléchargement, sans installation, sans inscription. Remarque : ceci est un simulateur développé indépendamment, pas un produit officiel Texas Instruments." } },
      { '@type': 'Question', name: "S'agit-il de la TI-84 Plus CE ou de la TI-84 Plus originale ?", acceptedAnswer: { '@type': 'Answer', text: "Le simulateur suit la disposition de touches standard partagée par la TI-84 Plus, la TI-84 Plus Silver Edition, la TI-84 Plus CE et la CE-T. Le traçage en couleur et les applications de la CE physique ne font pas partie de la version navigateur, mais les fonctions scientifiques, statistiques et le mode tableau sont identiques." } },
      { '@type': 'Question', name: 'Ce simulateur fonctionne-t-il sur mon téléphone ?', acceptedAnswer: { '@type': 'Answer', text: 'Oui — le simulateur est entièrement responsive sur iPhone, Android, iPad, tablettes et tous les navigateurs de bureau.' } },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang="fr" alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <CalculatorHub current="ti-84" lang="fr" />

    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        Calculatrice TI-84 Plus en Ligne <span class="text-primary">Gratuite</span>
      </h1>
      <p class="text-text-muted max-w-2xl mx-auto">
        Simulateur gratuit en ligne de la calculatrice graphique TI-84 Plus : fonctions scientifiques,
        statistiques, mode tableau et affichage style MathPrint — directement dans votre navigateur.
      </p>
      <p class="text-[11px] text-text-muted/70 mt-2 italic">
        Non affilié à Texas Instruments. Simulateur développé indépendamment.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      <div class="lg:col-span-2 xl:col-span-3 flex justify-center">
        <Calculator client:load model={ti84} />
      </div>

      <aside class="space-y-6">
        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Raccourcis Clavier</h3>
          <ul class="text-sm text-text-muted space-y-1.5">
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">0-9</kbd> Chiffres</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">+ − * /</kbd> Opérations</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Entrée</kbd> Calculer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Retour</kbd> Effacer</li>
            <li><kbd class="bg-bg px-1.5 py-0.5 rounded text-xs border border-border">Échap</kbd> Tout effacer</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Fonctionnalités</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Touches secondaires 2nd / ALPHA</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Trigonométrie (DEG / RAD / GRAD)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Affichage style MathPrint</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> log / ln / 10^x / e^x</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Statistiques 1-Var et 2-Var</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mode tableau de fonctions</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Mémoire STO→ / RCL (7 variables)</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Compatible mobile</li>
            <li class="flex gap-2"><span class="check-bullet" aria-hidden="true">✓</span> Sans téléchargement</li>
          </ul>
        </div>

        <div class="bg-bg-card rounded-xl border border-border p-5">
          <h3 class="font-semibold text-sm uppercase tracking-wide text-text-muted mb-3">Autres Calculatrices</h3>
          <ul class="text-sm text-text-muted space-y-2">
            <li><a href="/fr/ti-30xs/" class="text-primary hover:underline">TI-30XS MultiView</a></li>
            <li><a href="/fr/ti-85/" class="text-primary hover:underline">TI-85</a></li>
            <li><a href="/fr/ti-nspire/" class="text-primary hover:underline">TI-Nspire CX</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-4">Calculatrice TI-84 Plus en Ligne Gratuite</h2>
      <div class="text-text-muted space-y-4">
        <p>
          Vous cherchez une <strong class="text-text">calculatrice TI-84 en ligne</strong> ? Ce simulateur gratuit
          reproduit la disposition de touches de la TI-84 Plus (2nd, MODE, STAT, TABLE, STO→) directement dans
          votre navigateur. Idéal pour les <strong class="text-text">cours d'analyse, d'algèbre et de
          statistiques</strong>, les devoirs et la préparation aux examens.
        </p>
        <p>
          La <strong class="text-text">TI-84 Plus</strong> est la calculatrice graphique la plus utilisée dans les
          lycées et universités. Que vous fassiez vos devoirs ou révisiez un contrôle, ce simulateur vous donne la
          puissance scientifique de la TI-84 — <strong class="text-text">complètement gratuit, sans
          téléchargement</strong>.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Que peut faire cette calculatrice TI-84 ?</h3>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">Fonctions scientifiques</strong> — puissances, racines, valeur absolue, factorielles, notation scientifique</li>
          <li><strong class="text-text">Trigonométrie</strong> — sin, cos, tan et inverses en DEG / RAD / GRAD</li>
          <li><strong class="text-text">Logarithmes</strong> — ln, log, 10^x et e^x</li>
          <li><strong class="text-text">Statistiques</strong> — analyse 1-Var et 2-Var : moyenne, écart-type, somme, min, max, médiane</li>
          <li><strong class="text-text">Mode tableau</strong> — saisir Y₁ = … et générer une table x-y comme sur une vraie TI-84</li>
          <li><strong class="text-text">Mémoire STO→ / RCL</strong> — 7 variables nommées pour les calculs enchaînés</li>
          <li><strong class="text-text">Combinatoires</strong> — Permutations (nPr) et combinaisons (nCr)</li>
          <li><strong class="text-text">Priorité des opérations</strong> — parenthèses, multiplication implicite, affichage style MathPrint</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">Quelles variantes de la TI-84 ce simulateur couvre-t-il ?</h3>
        <p>
          Le simulateur suit la disposition de touches standard partagée par tous ces modèles :
        </p>
        <ul class="list-disc pl-6 space-y-1">
          <li><strong class="text-text">TI-84 Plus</strong> — le modèle original de 2004, encore très utilisé</li>
          <li><strong class="text-text">TI-84 Plus Silver Edition</strong> — plus de mémoire, applications Flash</li>
          <li><strong class="text-text">TI-84 Plus CE</strong> — écran couleur, batterie rechargeable (la version actuelle)</li>
          <li><strong class="text-text">TI-84 Plus CE-T</strong> — variante mode examen vendue en Europe</li>
        </ul>

        <h3 class="text-xl font-semibold text-text pt-4">TI-84 vs TI-30XS : Quelle est la différence ?</h3>
        <p>
          La <strong class="text-text">TI-84 Plus</strong> est une calculatrice graphique : elle trace des courbes
          Y=, exécute des programmes et gère des matrices. La <strong class="text-text">TI-30XS MultiView</strong>
          est une calculatrice scientifique — elle gère les fractions et les statistiques mais ne trace pas de
          courbes. Pour l'algèbre et la géométrie, la TI-30XS suffit ; pour l'analyse, choisissez la TI-84.
        </p>

        <h3 class="text-xl font-semibold text-text pt-4">Fonctionne sur tous les appareils</h3>
        <p>
          Cette calculatrice fonctionne sur <strong class="text-text">ordinateurs, ordinateurs portables, tablettes
          et smartphones</strong>. Entièrement responsive avec support tactile et clavier.
        </p>

        <div class="bg-bg-card/50 rounded-lg border border-border p-4 mt-6 text-xs text-text-muted/70">
          <strong>Avertissement :</strong> Ceci est un simulateur de calculatrice développé indépendamment.
          Il n'est pas fabriqué par, approuvé par, ou affilié à Texas Instruments Incorporated.
          TI-84 Plus, TI-30XS MultiView et MathPrint sont des marques déposées de Texas Instruments Incorporated, utilisées ici uniquement à des
          fins descriptives (usage référentiel, art. 14 RMUE). Ce simulateur a été développé à partir de zéro et ne contient aucun logiciel, micrologiciel ou code de Texas Instruments.
        </div>
      </div>
    </section>

    <section class="seo-section mt-16 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Questions Fréquentes</h2>
      <div class="space-y-4">
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Existe-t-il une calculatrice TI-84 Plus en ligne gratuite ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui ! Ce simulateur gratuit de TI-84 Plus couvre les fonctions scientifiques, les statistiques et le mode tableau — directement dans votre navigateur, sans installation ni inscription.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">S'agit-il de la TI-84 Plus CE ou de la TI-84 Plus originale ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">La disposition des touches correspond à la famille TI-84 Plus standard (Plus, Silver Edition, CE et CE-T). L'écran couleur et les applications de la CE physique ne sont pas inclus, mais les fonctions scientifiques et statistiques sont identiques.</p>
        </details>
        <details class="bg-bg-card rounded-xl border border-border p-5 group">
          <summary class="cursor-pointer font-medium list-none flex justify-between items-center">Fonctionne-t-il sur mon téléphone ?<span class="text-text-muted group-open:rotate-180 transition-transform">▼</span></summary>
          <p class="mt-3 text-text-muted text-sm">Oui. Le simulateur est entièrement responsive et fonctionne sur tous les smartphones, tablettes et navigateurs de bureau modernes.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
