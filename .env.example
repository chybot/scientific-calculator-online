# Public Analytics (exposed to browser; safe to commit examples here)

# Google Analytics 4 — get from analytics.google.com → Admin → Data Streams
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Cloudflare Web Analytics — get from dash.cloudflare.com → Analytics → Web Analytics → site → JS snippet
PUBLIC_CF_ANALYTICS_TOKEN=

# Both are only emitted in production builds. Leave empty in dev.
